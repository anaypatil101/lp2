public class StudentController {

    public Student__c student {get;set;}
    public List<Student__c> studentList {get;set;}

    public StudentController(){
        student = new Student__c();
        loadStudents();
    }

    public void loadStudents(){
        studentList = [SELECT Id, Name, RollNo__c, Class__c, Mobile_No__c 
                       FROM Student__c];
    }

    // CREATE
    public void saveStudent(){
        insert student;
        student = new Student__c();
        loadStudents();
    }

    // UPDATE (prepare record for editing)
    public void editStudent(){
        Id sid = ApexPages.currentPage().getParameters().get('sid');
        student = [SELECT Id, Name, RollNo__c, Class__c, Mobile_No__c 
                   FROM Student__c WHERE Id = :sid];
    }

    // UPDATE (save edited record)
    public void updateStudent(){
        update student;
        student = new Student__c();
        loadStudents();
    }

    // DELETE
    public void deleteStudent(){
        Id sid = ApexPages.currentPage().getParameters().get('sid');
        Student__c s = [SELECT Id FROM Student__c WHERE Id = :sid];
        delete s;
        loadStudents();
    }
}