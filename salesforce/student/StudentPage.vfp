<apex:page controller="StudentController">

<h2>Student Record Management</h2>

<apex:form>

Name:
<apex:inputField value="{!student.Name}"/><br/><br/>

Roll No:
<apex:inputField value="{!student.RollNo__c}"/><br/><br/>

Class:
<apex:inputField value="{!student.Class__c}"/><br/><br/>

Mobile No:
<apex:inputField value="{!student.Mobile_No__c}"/><br/><br/>

<apex:commandButton value="Save" action="{!saveStudent}"/>
<apex:commandButton value="Update" action="{!updateStudent}"/>

<br/><br/>

<h3>Student List</h3>

<apex:pageBlock>
<apex:pageBlockTable value="{!studentList}" var="s">

<apex:column value="{!s.Name}"/>
<apex:column value="{!s.RollNo__c}"/>
<apex:column value="{!s.Class__c}"/>
<apex:column value="{!s.Mobile_No__c}"/>

<apex:column headerValue="Edit">
<apex:commandLink value="Edit" action="{!editStudent}">
<apex:param name="sid" value="{!s.Id}"/>
</apex:commandLink>
</apex:column>

<apex:column headerValue="Delete">
<apex:commandLink value="Delete" action="{!deleteStudent}">
<apex:param name="sid" value="{!s.Id}"/>
</apex:commandLink>
</apex:column>

</apex:pageBlockTable>
</apex:pageBlock>

</apex:form>

</apex:page>